#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <locale/keys_de.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
                        bindings =
   &kp TAB   &kp DE_Q &kp DE_W &kp DE_E &kp DE_R &kp DE_T   &kp DE_Z &kp DE_U &kp DE_I     &kp DE_O   &kp DE_P        &kp BSPC
   &kp LCTRL &kp DE_A &kp DE_S &kp DE_D &kp DE_F &kp DE_G   &kp DE_H &kp DE_J &kp DE_K     &kp DE_L   &kp DE_O_UMLAUT &kp DE_A_UMLAUT
   &kp LSHFT &kp DE_Y &kp DE_X &kp DE_C &kp DE_V &kp DE_B   &kp DE_N &kp DE_M &kp DE_COMMA &kp DE_DOT &kp DE_MINUS    &kp ESC
                          &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };

                lower_layer {
                        display-name = "Lower";
                        bindings =
   &kp TAB    &kp DE_N1    &kp DE_N2    &kp DE_N3    &kp DE_N4    &kp DE_N5      &kp DE_N6 &kp DE_N7 &kp DE_N8 &kp DE_N9 &kp DE_N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp DE_SZ &kp DE_U_UMLAUT
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans    &trans    &trans    &trans    &trans    &trans
                                   &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "Raise";
                        bindings =
   &kp TAB   &kp DE_EXCLAMATION &kp DE_AT &kp DE_HASH &kp DE_DOLLAR &kp DE_PERCENT   &kp DE_CARET      &kp DE_AMPERSAND &kp DE_ASTERISK     &kp DE_LEFT_PARENTHESIS &kp DE_RIGHT_PARENTHESIS &kp BSPC
   &kp LCTRL &kp DE_EURO        &trans    &trans      &trans        &trans           &kp DE_MINUS      &kp DE_EQUAL     &kp DE_LEFT_BRACKET &kp DE_RIGHT_BRACKET    &kp DE_BACKSLASH         &kp DE_GRAVE
   &kp LSHFT &trans             &trans    &trans      &trans        &trans           &kp DE_UNDERSCORE &kp DE_PLUS      &kp DE_LEFT_BRACE   &kp DE_RIGHT_BRACE      &kp DE_PIPE              &kp DE_TILDE
                          &kp LGUI &trans &kp SPACE   &kp RET &trans &kp RALT
                        >;
                };

                extra_1 { status = "reserved"; };
                extra_2 { status = "reserved"; };
                extra_3 { status = "reserved"; };
        };
};